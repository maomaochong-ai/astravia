{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@astravia/capability-sdk": ["./packages/capability-sdk/src/index.ts"],
			"@astravia/capability-sdk/internal/plugin-adapter": ["./packages/capability-sdk/src/adapters/plugin/index.ts"],
			"@astravia/capability-sdk/internal/theme-adapter": ["./packages/capability-sdk/src/adapters/theme.ts"],
			"@astravia/capability-sdk/*": ["./packages/capability-sdk/src/*"],
			"@astravia/capability-runtime": ["./packages/capability-runtime/src/index.ts"],
			"@astravia/capability-runtime/*": ["./packages/capability-runtime/src/*"],
			"@astravia/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@astravia/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@astravia/ai": ["./packages/ai/src/index.ts"],
			"@astravia/ai/*": ["./packages/ai/src/*"],
			"@astravia/ai/dist/*": ["./packages/ai/src/*"],
			"@astravia/agent-core": ["./packages/agent/src/index.ts"],
			"@astravia/agent-core/*": ["./packages/agent/src/*"],
			"@astravia/ecosystem-adapter": ["./packages/ecosystem-adapter/src/index.ts"],
			"@astravia/ecosystem-adapter/hooks": ["./packages/ecosystem-adapter/src/hooks/index.ts"],
			"@astravia/ecosystem-adapter/codex/hooks": ["./packages/ecosystem-adapter/src/codex/hooks/index.ts"],
			"@astravia/ecosystem-adapter/*": ["./packages/ecosystem-adapter/src/*"],
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox"],
			"@astravia/runtime-core": ["./packages/runtime-core/src/index.ts"],
			"@astravia/runtime-core/*": ["./packages/runtime-core/src/*"],
			"@astravia/action-rpc": ["./packages/action-rpc/src/index.ts"],
			"@astravia/action-rpc/*": ["./packages/action-rpc/src/*"],
			"@astravia-org/plugin-sdk": ["./packages/plugins/plugin-sdk/src/index.ts"],
			"@astravia-org/plugin-sdk/*": ["./packages/plugins/plugin-sdk/src/*"],
			"@astravia-org/plugin-vite": ["./packages/plugins/plugin-vite/src/index.ts"],
			"@astravia-org/plugin-vite/*": ["./packages/plugins/plugin-vite/src/*"],
			"@astravia/theme-sdk": ["./packages/theme-sdk/src/index.ts"],
			"@astravia/theme-sdk/*": ["./packages/theme-sdk/src/*"],
			"@astravia/theme-ui": ["./packages/theme-ui/src/index.ts"],
			"@astravia/theme-ui/*": ["./packages/theme-ui/src/*"],
			"@astravia/ui": ["./packages/ui/src/index.ts"],
			"@astravia/ui/*": ["./packages/ui/src/*"],
			"@astravia/runtime-tools": ["./packages/runtime-tools/src/index.ts"],
			"@astravia/runtime-tools/*": ["./packages/runtime-tools/src/*"],
			"@astravia/runtime-mcp": ["./packages/runtime-mcp/src/index.ts"],
			"@astravia/runtime-mcp/*": ["./packages/runtime-mcp/src/*"],
			"@astravia/runtime-storage": ["./packages/runtime-storage/src/index.ts"],
			"@astravia/runtime-storage/*": ["./packages/runtime-storage/src/*"],
			"@astravia/runtime-telemetry": ["./packages/runtime-telemetry/src/index.ts"],
			"@astravia/runtime-telemetry/langfuse": ["./packages/runtime-telemetry/src/langfuse.ts"],
			"@astravia/runtime-telemetry/*": ["./packages/runtime-telemetry/src/*"],
			"@astravia/cli-app": ["./packages/cli-app/src/index.ts"],
			"@astravia/cli-app/*": ["./packages/cli-app/src/*"],
			"@astravia/toolkit": ["./packages/toolkit/src/index.ts"],
			"@astravia/toolkit/*": ["./packages/toolkit/src/*"]
		}
	},
	"include": [
		"packages/capability-sdk/src/**/*",
		"packages/capability-runtime/src/**/*",
		"packages/ai/src/**/*",
		"packages/ai/test/**/*",
		"packages/agent/src/**/*",
		"packages/agent/test/**/*",
		"packages/ecosystem-adapter/src/**/*",
		"packages/coding-agent/src/**/*",
		"packages/coding-agent/test/**/*",
		"packages/runtime-core/src/**/*",
		"packages/action-rpc/src/**/*",
		"packages/plugins/plugin-sdk/src/**/*",
		"packages/plugins/plugin-vite/src/**/*",
		"packages/runtime-tools/src/**/*",
		"packages/runtime-mcp/src/**/*",
		"packages/runtime-storage/src/**/*",
		"packages/runtime-telemetry/src/**/*",
		"packages/cli-app/src/**/*",
		"packages/toolkit/src/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**"]
}
